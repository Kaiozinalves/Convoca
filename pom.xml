<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM PAI do projeto.
  Não gera nenhum jar: só agrupa os módulos (framework + instâncias)
  e centraliza versões/configurações comuns a todos eles.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.convoca</groupId>
	<artifactId>convoca-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>convoca-parent</name>
	<description>Convoca: framework para gestão de grupos que se reúnem periodicamente + suas instâncias</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<!-- Ordem de build: o framework primeiro, depois as instâncias que dependem dele -->
	<modules>
		<module>framework</module>
		<module>instancias/pelmanager</module>
		<module>instancias/noite-esportes</module>
		<module>instancias/acao-social</module>
	</modules>

	<!-- Versões gerenciadas num lugar só; os módulos declaram a dependência sem versão -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.convoca</groupId>
				<artifactId>convoca-framework</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
